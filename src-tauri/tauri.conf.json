{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "URIGG HUB",
  "version": "0.1.11",
  "identifier": "dev.urigg.hub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Security.log HUB",
        "width": 1440,
        "height": 810,
        "minWidth": 1100,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Security.log HUB",
    "copyright": "© 2026 URIGG",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Korean"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4RDYxOTZDMDVFMjY3QjQKUldTMForSUZiQm5XbUM1QnViQmhVSGltcW5KU1FlTlpteDNWNm9iWmhiRjMxY1NId2hvUmo0ZlMK",
      "endpoints": [
        "https://github.com/yde5536/URIGG-DesktopApp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
